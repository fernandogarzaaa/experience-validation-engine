{
  "name": "experience-validation-engine",
  "version": "0.3.1",
  "description": "EVE — an autonomous cognitive simulation engine that evaluates software through the perspective of realistic human operators. AI that experiences software like a human.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "bin": {
    "eve": "./bin/eve.js",
    "eve-mcp": "./bin/eve-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "mcp": "node bin/eve-mcp.js",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "lint": "biome check src tests examples",
    "lint:fix": "biome check --write src tests examples",
    "format": "biome format --write src tests examples"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "ux",
    "usability",
    "testing",
    "cognitive-simulation",
    "persona",
    "browser-automation",
    "experience-validation",
    "accessibility",
    "ai-agent",
    "mcp",
    "model-context-protocol",
    "claude",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandogarzaaa/experience-validation-engine.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.4.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "playwright": ">=1.40.0",
    "puppeteer": ">=21.0.0",
    "selenium-webdriver": ">=4.16.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    },
    "selenium-webdriver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "playwright": "^1.62.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
