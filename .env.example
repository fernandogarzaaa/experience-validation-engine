# Environment variables read by EVE. All are optional; copy to .env (or set in
# your shell / MCP client config) only the ones you need. Never commit real values.

# Shared fleet key for the CP/1 validation endpoint (bin/eve-cp1.js).
CP1_FLEET_KEY=

# Set to 1 to log MCP tool debug output to stderr (src/mcp/tools.ts).
EVE_MCP_DEBUG=

# Overrides the implementation revision stamped into records (src/core/versions.ts).
EVE_IMPLEMENTATION_REVISION=
